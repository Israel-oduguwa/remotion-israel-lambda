REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1

# Optional: protect POST /render/lambda and progress polling when API is public.
RENDER_API_TOKEN=
LAMBDA_WAIT_TIMEOUT_MS=900000
LAMBDA_WAIT_POLL_INTERVAL_MS=2000

# Optional speed/quality knobs. Use concurrency OR frames per Lambda, not both.
REMOTION_RENDER_CONCURRENCY=20
# REMOTION_RENDER_FRAMES_PER_LAMBDA=40
REMOTION_FUNCTION_MEMORY_MB=3008
REMOTION_FUNCTION_DISK_MB=4096
REMOTION_FUNCTION_TIMEOUT_SEC=240
